---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="py-12 flex flex-col items-center text-center">
    <!-- Emblem Display -->
    <div class="relative mb-8 group">
      <div class="absolute -inset-1 rounded-full bg-emerald-500/20 blur-xl group-hover:bg-emerald-500/40 transition-all duration-500"></div>
      <div class="relative w-40 h-40 md:w-48 md:h-48 rounded-full border-2 border-emerald-500/50 bg-[#0d121d] p-2 flex items-center justify-center shadow-2xl">
        <img src="/assets/logo.png" alt="sett49 logo" class="w-full h-full object-contain" />
      </div>
    </div>

    <!-- Title & Subtitle -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 text-xs tracking-widest uppercase mb-4">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
      Military Technical Academy "Ferdinand I"
    </div>

    <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight mb-4">
      Analyzing. Exploiting. <span class="text-emerald-400 glow-text">Securing.</span>
    </h1>

    <p class="max-w-2xl text-slate-400 text-base md:text-lg mb-8 leading-relaxed">
      Echipa academică de securitate cibernetică și Capture The Flag (CTF) din cadrul Academiei Tehnice Militare „Ferdinand I”.
    </p>

    <!-- Call to Actions -->
    <div class="flex flex-wrap gap-4 justify-center font-mono">
      <a href="https://ctftime.org/team/422471" target="_blank" class="px-6 py-3 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-black font-semibold transition-all shadow-lg shadow-emerald-500/20 flex items-center gap-2">
        <span>CTFtime Profile</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
      </a>
      <a href="/writeups" class="px-6 py-3 rounded-lg border border-slate-700 bg-slate-900/50 hover:bg-slate-800 text-slate-200 transition-all flex items-center gap-2">
        <span>View Writeups</span>
      </a>
    </div>
  </section>

  <!-- Quick Stats Grid -->
  <section class="grid grid-cols-1 md:grid-cols-3 gap-6 my-12 font-mono">
    <div class="p-6 rounded-xl border border-slate-800 bg-[#0e131f]/60 backdrop-blur-sm">
      <div class="text-emerald-400 text-xs tracking-wider uppercase mb-1">// DOMAINS</div>
      <div class="text-xl font-bold text-white mb-2">Pwn & Reversing</div>
      <p class="text-sm text-slate-400">Binary exploitation, reverse engineering, x86/ARM assembly & kernel vulnerability research.</p>
    </div>

    <div class="p-6 rounded-xl border border-slate-800 bg-[#0e131f]/60 backdrop-blur-sm">
      <div class="text-emerald-400 text-xs tracking-wider uppercase mb-1">// DOMAINS</div>
      <div class="text-xl font-bold text-white mb-2">Web & Crypto</div>
      <p class="text-sm text-slate-400">Web application penetration testing, custom protocol analysis & applied cryptography.</p>
    </div>

    <div class="p-6 rounded-xl border border-slate-800 bg-[#0e131f]/60 backdrop-blur-sm">
      <div class="text-emerald-400 text-xs tracking-wider uppercase mb-1">// DOMAINS</div>
      <div class="text-xl font-bold text-white mb-2">Forensics & Hardware</div>
      <p class="text-sm text-slate-400">Memory forensics, network traffic analysis, disk artifacts & embedded firmware exploitation.</p>
    </div>
  </section>
</Layout>