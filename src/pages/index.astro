---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="py-12 flex flex-col items-center text-center">
    <!-- Emblem Display — logo original, fără invert -->
    <div class="relative mb-8 group">
      <div class="absolute -inset-1 rounded-full bg-black/5 blur-xl group-hover:bg-black/10 transition-all duration-500"></div>
      <div class="relative w-40 h-40 md:w-48 md:h-48 rounded-full border border-slate-200 bg-white p-2 flex items-center justify-center shadow-lg group-hover:border-slate-400 transition-all duration-300">
        <Image src={logo} alt="sett49 logo" width={384} height={384} loading="eager" fetchpriority="high" class="w-full h-full object-contain" />
      </div>
    </div>

    <!-- Title & Subtitle -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-slate-200 bg-slate-100 text-slate-500 text-xs tracking-widest uppercase mb-4">
      <span class="w-2 h-2 rounded-full bg-slate-800 animate-ping opacity-60"></span>
      Military Technical Academy "Ferdinand I"
    </div>

    <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 tracking-tight mb-4">
      Analyzing. Exploiting. <span class="glow-text text-black">Securing.</span>
    </h1>

    <p class="max-w-3xl text-center text-slate-700 text-base md:text-lg mb-8 leading-relaxed">
      Cercul studențesc de securitate cibernetică și Capture The Flag (CTF) din cadrul <span class="md:whitespace-nowrap">Academiei Tehnice Militare „Ferdinand I".</span>
    </p>

    <!-- Call to Actions -->
    <div class="flex flex-wrap gap-4 justify-center font-mono">
      <a href="https://ctftime.org/team/422471" target="_blank" rel="noopener noreferrer" class="px-6 py-3 rounded-lg bg-black hover:bg-neutral-800 text-white font-semibold transition-all shadow-sm flex items-center gap-2">
        <span>CTFtime Profile</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
      </a>
      <a href="/results/" class="px-6 py-3 rounded-lg border border-black bg-white hover:bg-slate-100 hover:shadow-md hover:-translate-y-0.5 text-black font-semibold transition-all flex items-center gap-2">
        <span>View Results</span>
      </a>
    </div>
  </section>

  <!-- Domains — taguri simple -->
  <section class="flex flex-wrap gap-3 justify-center my-10 font-mono">
    {['Pwn', 'Reversing', 'Web', 'Crypto', 'Forensics', 'Hardware', 'OSINT', 'Misc'].map(tag => (
      <span class="px-4 py-1.5 rounded-md border border-black bg-white text-black font-semibold text-sm tracking-wide hover:bg-slate-100 hover:shadow-md hover:-translate-y-0.5 transition-all cursor-default">
        {tag}
      </span>
    ))}
  </section>
</Layout>
