---
import Layout from '../layouts/Layout.astro';
import ctftimeData from '../data/ctftime.json';
import manualData from '../data/manual.json';
import { Image } from 'astro:assets';

// Combină membrii din CTFtime cu membrii adăugați manual (ex: cei fără cont încă)
const roleMap: Record<string, string> = manualData.memberRoles || {};
const contactMap: Record<string, Record<string, string>> = (manualData as any).memberContacts || {};
const extraMembers = manualData.extraMembers || [];

// Metode de contact. Pentru una noua: adauga o cheie aici (icon + link) si apoi in manual.json -> memberContacts.
// Daca valoarea e deja URL (http...), se foloseste ca atare. `href: null` = doar text (ex: discord).
// `iconOnly: true` = afiseaza doar iconita (valoarea apare la hover, in tooltip).
const contactTypes: Record<string, { icon: string; href: ((v: string) => string) | null; iconOnly?: boolean }> = {
  email: {
    icon: '<rect x="3" y="5" width="18" height="14" rx="2" /><path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6" />',
    href: v => `mailto:${v}`,
    iconOnly: true,
  },
  discord: {
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M8 8.5c2.7-.9 5.3-.9 8 0M8.5 16.5c2.5.8 4.5.8 7 0M6.5 18.5 5 17c0-4 1-8 2.5-11 1.3-.6 2.5-1 3.8-1.2l.5 1M17.5 18.5 19 17c0-4-1-8-2.5-11-1.3-.6-2.5-1-3.8-1.2l-.5 1" /><circle cx="9.5" cy="12.5" r=".8" /><circle cx="14.5" cy="12.5" r=".8" />',
    href: null,
  },
  instagram: {
    icon: '<rect x="4" y="4" width="16" height="16" rx="4.5" /><circle cx="12" cy="12" r="3.5" /><circle cx="16.8" cy="7.2" r=".6" />',
    href: v => `https://instagram.com/${v.replace(/^@/, '')}`,
  },
  github: {
    icon: '<path fill="currentColor" stroke="none" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />',
    href: v => `https://github.com/${v.replace(/^@/, '')}`,
    iconOnly: true,
  },
  linkedin: {
    icon: '<rect x="4" y="4" width="16" height="16" rx="2" /><path stroke-linecap="round" d="M8 11v5M8 8v.01M12 16v-5m0 2c0-1.100.9-2 2-2s2 .9 2 2v3" />',
    href: v => `https://linkedin.com/in/${v}`,
  },
  website: {
    icon: '<circle cx="12" cy="12" r="9" /><path stroke-linecap="round" d="M3 12h18M12 3c2.500 2.500 3.500 5.500 3.500 9s-1 6.500-3.500 9c-2.500-2.500-3.500-5.500-3.500-9S9.500 5.500 12 3Z" />',
    href: v => v,
  },
};

function getContacts(handle: string) {
  return Object.entries(contactMap[handle] || {})
    .map(([type, raw]) => ({ type, value: (raw || '').trim() }))
    .filter(c => c.value && contactTypes[c.type])
    .sort((a, b) => Number(b.type === 'email') - Number(a.type === 'email')) // email primul
    .map(c => {
      const t = contactTypes[c.type];
      const isUrl = /^https?:\/\//.test(c.value);
      const href = isUrl ? c.value : t.href ? t.href(c.value) : null;
      return { type: c.type, value: c.value, icon: t.icon, href, iconOnly: !!t.iconOnly };
    });
}

const ctftimeHandles = new Set(ctftimeData.members.map(m => m.handle));
const members = [
  ...ctftimeData.members.map(m => ({
    handle: m.handle,
    ctftime: m.ctftime,
    role: roleMap[m.handle] || '???',
    contacts: getContacts(m.handle),
  })),
  ...extraMembers
    .filter(m => !ctftimeHandles.has(m.handle))
    .map(m => ({
      handle: m.handle,
      ctftime: m.ctftime,
      role: roleMap[m.handle] || '???',
      contacts: getContacts(m.handle),
    contacts: getContacts(m.handle),
    })),
];

// Poze de profil: pune src/assets/avatars/<handle>.(png|jpg|jpeg|webp) - fallback la initiale
const avatarFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/avatars/*.{png,jpg,jpeg,webp}', { eager: true });
const avatarMap: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(avatarFiles)) {
  const name = path.split('/').pop()!.replace(/\.[^.]+$/, '');
  avatarMap[name.toLowerCase()] = mod.default;
}

function getInitials(handle: string): string {
  return handle.replace(/[^a-zA-Z0-9]/g, '').slice(0, 2).toUpperCase();
}

// Categorii cu chip colorat. Adauga aici altele; clasele Tailwind trebuie sa fie complete (statice).
const categoryStyles: Record<string, string> = {
  pwn: 'bg-red-100 text-red-700 border-red-300',
  rev: 'bg-green-100 text-green-700 border-green-300',
  web: 'bg-blue-100 text-blue-700 border-blue-300',
  crypto: 'bg-purple-100 text-purple-700 border-purple-300',
  forensics: 'bg-amber-100 text-amber-700 border-amber-300',
  osint: 'bg-cyan-100 text-cyan-700 border-cyan-300',
  misc: 'bg-slate-100 text-slate-700 border-slate-300',
};

// "hack/the/planet\nrev/pwn" -> randuri; pe un rand, daca toate segmentele sunt categorii cunoscute -> chips, altfel text simplu
function parseRole(role: string) {
  return role.split('\n').map(line => {
    const parts = line.split('/').map(p => p.trim()).filter(Boolean);
    const isChips = parts.length > 0 && parts.every(p => categoryStyles[p.toLowerCase()]);
    return { text: line, chips: isChips ? parts : [] };
  });
}

const avatarStyles = [
  'border-slate-400 text-slate-800',
  'border-slate-500 text-slate-700',
  'border-slate-300 text-slate-900',
  'border-slate-400 text-slate-800',
  'border-slate-500 text-slate-700',
  'border-slate-300 text-slate-800',
];
---

<Layout title="Team">
  <!-- Header secțiune -->
  <section class="mb-12">
    <div class="flex items-center gap-2 text-slate-900 text-xs font-mono tracking-widest uppercase mb-4">
      <span class="text-slate-600">$</span> cat /etc/team.conf
    </div>

    <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-3">
      The <span class="glow-text text-black">Operators</span>
    </h1>

    <!-- Stats bar -->
    <div class="flex flex-wrap gap-6 font-mono text-sm">
      <div class="flex items-center gap-2">
        <span class="text-slate-600">//</span>
        <span class="text-slate-900 font-bold">{members.length}</span>
        <span class="text-slate-600">membri activi</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-slate-600">//</span>
        <span class="text-slate-900 font-bold">sett49</span>
        <span class="text-slate-600">pe CTFtime</span>
      </div>
    </div>
  </section>

  <!-- Grid membrii -->
  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {members.map((member, i) => {
      const style = avatarStyles[i % avatarStyles.length];
      const initials = getInitials(member.handle);
      return (
        <div class="group p-5 rounded-xl border border-slate-200 bg-white hover:border-slate-400 hover:shadow-sm transition-all duration-200">
          <div class="flex items-start gap-4">
            <!-- Avatar -->
            <div class={`flex-shrink-0 w-12 h-12 rounded-lg overflow-hidden border-2 ${style} bg-slate-50 flex items-center justify-center font-mono font-bold text-sm`}>
              {avatarMap[member.handle.toLowerCase()] ? (
                <Image src={avatarMap[member.handle.toLowerCase()]} alt={member.handle} width={96} height={96} class="w-full h-full object-cover" />
              ) : initials}
            </div>

            <!-- Info -->
            <div class="flex-1 min-w-0">
              <!-- Handle -->
              <div class="flex items-center justify-between gap-2">
                <div class="font-mono font-bold text-slate-900 text-sm truncate min-w-0">
                  <span class="text-slate-500">&gt;</span> {member.handle}
                </div>
                <span class="flex-shrink-0 px-2 py-0.5 rounded-md border border-slate-300 bg-slate-100 text-slate-600 text-[10px] leading-4 font-mono font-semibold uppercase tracking-wider">undergraduate</span>
              </div>

              <!-- Rol -->
              <div class="text-xs text-slate-600 font-mono mt-1 space-y-1">
                {parseRole(member.role).map(row => (
                  <div class="flex flex-wrap items-center gap-1.5">
                    {row.chips.length ? (
                      row.chips.map(c => (
                        <span class={`px-2 py-0.5 rounded-md border font-semibold ${categoryStyles[c.toLowerCase()]}`}>{c}</span>
                      ))
                    ) : (
                      <span><span class="text-slate-400">// </span>{row.text}</span>
                    )}
                  </div>
                ))}
              </div>

              <!-- Links -->
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mt-3">
                {member.contacts.map(c => {
                  const inner = (
                    <>
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true" set:html={c.icon} />
                      {!c.iconOnly && <span class="truncate">{c.value}</span>}
                    </>
                  );
                  return c.href ? (
                    <a href={c.href} target={c.type === 'email' ? undefined : '_blank'} rel="noopener noreferrer" title={c.iconOnly ? c.value : c.type} aria-label={`${c.type}: ${c.value}`} class="inline-flex items-center gap-1.5 text-xs font-mono text-slate-700 hover:text-black transition-colors min-w-0">{inner}</a>
                  ) : (
                    <span title={c.type} class="inline-flex items-center gap-1.5 text-xs font-mono text-slate-700 min-w-0">{inner}</span>
                  );
                })}
                {member.ctftime && (
                  <a
                    href={member.ctftime}
                    target="_blank"
                    rel="noopener noreferrer"
                    title="CTFtime"
                    aria-label="CTFtime"
                    class="inline-flex items-center text-slate-700 hover:text-black transition-colors"
                  >
                    <img src="/assets/ctftime.png" alt="" class="w-4 h-4 rounded-sm" />
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      );
    })}
  </section>
</Layout>
